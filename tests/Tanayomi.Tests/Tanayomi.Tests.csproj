  </ItemGroup>
  <Import Project="../../native/SkiaNative.targets" />
  <Target Name="TrimWindowsX64TestNativeAssets" AfterTargets="ResolvePackageAssets"
          Condition="'$(OS)' == 'Windows_NT' and '$(RuntimeIdentifier)' == '' and
                     '$(NETCoreSdkPortableRuntimeIdentifier)' == 'win-x64' and
                     '$(DefaultAppHostRuntimeIdentifier)' == 'win-x64' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)"
          Condition="'%(RuntimeTargetsCopyLocalItems.AssetType)' == 'native' and
                     ('%(RuntimeTargetsCopyLocalItems.Filename)' == 'libSkiaSharp' or '%(RuntimeTargetsCopyLocalItems.Filename)' == 'libHarfBuzzSharp') and
                     ('%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' != 'win-x64' or '%(RuntimeTargetsCopyLocalItems.Extension)' == '.pdb')" />
    </ItemGroup>
  </Target>
</Project>

