<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Tanayomi.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="#DEE6F1" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#91A3B9" /></Style>
    <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="19" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="#172131" /><Setter Property="CornerRadius" Value="16" /><Setter Property="Padding" Value="22" /><Setter Property="BorderBrush" Value="#29364A" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="9" /><Setter Property="Padding" Value="18,11" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#64DEC1" /><Setter Property="Foreground" Value="#10251F" /></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="8" /></Style>
  </Application.Styles>
</Application>
