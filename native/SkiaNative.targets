<Project>
  <PropertyGroup>
    <SkiaNativeDirectory Condition="'$(SkiaNativeDirectory)' == ''">$(MSBuildThisFileDirectory)../.local/build/native-skia</SkiaNativeDirectory>
    <AuditedSkiaEnabled Condition="('$(RuntimeIdentifier)' == 'win-x64' or ('$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT')) and (Exists('$(SkiaNativeDirectory)/skia-build.json') or '$(SkiaGeneratedManifestSha256)' != '')">true</AuditedSkiaEnabled>
    <SkiaNativeNotice>$(MSBuildThisFileDirectory)../assets/skia-native-NOTICES.txt</SkiaNativeNotice>
    <SkiaNativeNotice Condition="'$(SkiaGeneratedManifestSha256)' != ''">$(SkiaNativeDirectory)/skia-native-NOTICES.txt</SkiaNativeNotice>
  </PropertyGroup>
  <ItemGroup Condition="'$(AuditedSkiaEnabled)' == 'true'">
    <AuditedSkiaFile Include="$(SkiaNativeDirectory)/libSkiaSharp.dll" ExpectedHash="828EF8C611AD23EC33CA1A6581A8CFE8F0CBB45925C0AE87CFC074BAED8C2458" />
    <AuditedSkiaFile Include="$(SkiaNativeDirectory)/msvcp140.dll" ExpectedHash="43A9666C2F405258F165B53082860AC7838039A75FD2E85286085EDE0DA0273B" />
    <AuditedSkiaFile Include="$(SkiaNativeDirectory)/vcruntime140.dll" ExpectedHash="C865C3366A98431EC3A5959CB5AC3966081A43B82DFCD8BFEFAFE0146B1508DB" />
    <AuditedSkiaFile Include="$(SkiaNativeDirectory)/vcruntime140_1.dll" ExpectedHash="6C1E531C25AB2934A4EA9970598BC751D924D7CC5650DF3E1282B61D6CD24F42" />
    <None Include="$(SkiaNativeNotice)" Link="licenses/skia-native-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)../assets/microsoft-vc-runtime-LICENSE.txt" Link="licenses/skia-microsoft-vc-runtime-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(SkiaNativeDirectory)/skia-build.json" Link="licenses/skia-build.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Condition="'$(SkiaGeneratedManifestSha256)' != ''" Include="$(SkiaNativeDirectory)/skia-generated.xml" Link="licenses/skia-generated.xml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ValidateAuditedSkia" BeforeTargets="CopyFilesToOutputDirectory;Publish" Condition="'$(AuditedSkiaEnabled)' == 'true'">
    <Error Condition="'$(SkiaGeneratedManifestSha256)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(SkiaGeneratedManifestSha256)', '^[A-Fa-f0-9]{64}$'))" Text="Specify the SHA256 printed by build-skia.ps1 -Action Stage for this generated Skia manifest." />
    <GetFileHash Condition="'$(SkiaGeneratedManifestSha256)' != ''" Files="$(SkiaNativeDirectory)/skia-generated.xml" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_SkiaActualManifestHash" />
    </GetFileHash>
    <Error Condition="'$(SkiaGeneratedManifestSha256)' != '' and '$(_SkiaActualManifestHash)' != '$(SkiaGeneratedManifestSha256)'" Text="Generated Skia audit manifest hash mismatch." />
    <XmlPeek Condition="'$(SkiaGeneratedManifestSha256)' != ''" XmlInputPath="$(SkiaNativeDirectory)/skia-generated.xml" Query="/SkiaBuild[@Schema='1' and @SourceCommit='7dbfc07dd33181f84e0958afb7ee805c6c769f0b' and @Runtime='dynamic /MD' and @PeVerified='true' and @ManagedVerified='true']/@CandidateSha256">
      <Output TaskParameter="Result" PropertyName="_SkiaGeneratedCandidateHash" />
    </XmlPeek>
    <Error Condition="'$(SkiaGeneratedManifestSha256)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(_SkiaGeneratedCandidateHash)', '^[A-F0-9]{64}$'))" Text="Generated Skia manifest lacks the fixed source, PE/ABI and managed audit contract." />
    <XmlPeek Condition="'$(SkiaGeneratedManifestSha256)' != ''" XmlInputPath="$(SkiaNativeDirectory)/skia-generated.xml" Query="/SkiaBuild/File[@Path='skia-native-NOTICES.txt']/@Sha256">
      <Output TaskParameter="Result" PropertyName="_SkiaGeneratedNoticeHash" />
    </XmlPeek>
    <XmlPeek Condition="'$(SkiaGeneratedManifestSha256)' != ''" XmlInputPath="$(SkiaNativeDirectory)/skia-generated.xml" Query="/SkiaBuild/File[@Path='skia-build.json']/@Sha256">
      <Output TaskParameter="Result" PropertyName="_SkiaGeneratedBuildRecordHash" />
    </XmlPeek>
    <ItemGroup Condition="'$(SkiaGeneratedManifestSha256)' != ''">
      <AuditedSkiaFile Condition="'%(AuditedSkiaFile.Filename)%(AuditedSkiaFile.Extension)' == 'libSkiaSharp.dll'">
        <ExpectedHash>$(_SkiaGeneratedCandidateHash)</ExpectedHash>
      </AuditedSkiaFile>
      <_SkiaStageMetadata Include="$(SkiaNativeDirectory)/skia-native-NOTICES.txt" ExpectedHash="$(_SkiaGeneratedNoticeHash)" />
      <_SkiaStageMetadata Include="$(SkiaNativeDirectory)/skia-build.json" ExpectedHash="$(_SkiaGeneratedBuildRecordHash)" />
    </ItemGroup>
    <GetFileHash Files="@(AuditedSkiaFile);@(_SkiaStageMetadata)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="VerifiedSkiaFile" />
    </GetFileHash>
    <Error Condition="'%(VerifiedSkiaFile.FileHash)' != '%(VerifiedSkiaFile.ExpectedHash)'" Text="Audited Skia/CRT input hash mismatch: %(VerifiedSkiaFile.Filename)%(VerifiedSkiaFile.Extension)" />
  </Target>
  <Target Name="CopyAuditedSkiaBuild" AfterTargets="CopyFilesToOutputDirectory" DependsOnTargets="ValidateAuditedSkia" Condition="'$(AuditedSkiaEnabled)' == 'true'">
    <Copy SourceFiles="@(AuditedSkiaFile)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(AuditedSkiaFile)" DestinationFolder="$(TargetDir)runtimes/win-x64/native/" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyAuditedSkiaPublish" AfterTargets="Publish" DependsOnTargets="ValidateAuditedSkia" Condition="'$(AuditedSkiaEnabled)' == 'true'">
    <Copy SourceFiles="@(AuditedSkiaFile)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
