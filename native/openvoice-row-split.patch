+        Parameters->OutputShape[0] == 1 && Parameters->OutputShape[1] == 32 &&
+        Parameters->KernelShape[0] == 1 && Parameters->KernelShape[1] == 5 &&
+        Parameters->StrideShape[0] == 1 && Parameters->StrideShape[1] == 1 &&
+        Parameters->DilationShape[0] == 1 && Parameters->DilationShape[1] == 1 &&
+        Parameters->Padding[0] == 0 && Parameters->Padding[1] == 2 &&
+        Parameters->Padding[2] == 0 && Parameters->Padding[3] == 2;
+}
 
